      "journalInfo": {
        "volume": "12",
        "journalIssueId": 2471653,
        "dateOfPublication": "2012 Nov",
        "monthOfPublication": 11,
        "yearOfPublication": 2012,
        "printPublicationDate": "2012-11-01",
        "journal": {
          "title": "BMC microbiology",
          "medlineAbbreviation": "BMC Microbiol",
