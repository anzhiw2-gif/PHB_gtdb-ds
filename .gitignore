# arguments of a mis-quoted shell command (`--amino`, `-o`, `=.8=%d`).
# Excluded from version control rather than deleted; they remain on disk.
_session_import/
.mplconfig/
_audit_pool_in_evidence.py
--amino
-o
=.8=%d
.tmp_debug.py
.tmp_debug2.py
tmp_f14_probe.py
