# Copy to a private shell environment; do not commit real values.
PHB_REPO_ROOT=/path/to/PHB_gtdb-ds
PHB_SOURCE_ROOT=/path/to/PHB_gtdb-ds
PHB_PYTHON=/path/to/python
PHB_GTDB_ROOT=/path/to/gtdb_genomes_reps_r232/database
PHB_GTDB_TAXONOMY=/path/to/bac120_taxonomy_r232.tsv
PHB_GTDB_METADATA=/path/to/bac120_metadata_r232.tsv.gz
PHB_GTDB_TREE=/path/to/bac120_r232.tree
PHB_CONDA_SH=/path/to/conda.sh
PHB_CONDA_ENV=phb_gtdb
SIGNALP6_BIN=signalp6
SYNC_SERVER=user@host
SYNC_REMOTE=/path/to/PHB_gtdb-ds
